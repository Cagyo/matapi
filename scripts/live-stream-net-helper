#!/usr/bin/python3
"""Root-only, authenticated RTSP egress lease helper.

The protocol accepts grant/revoke records only. It never accepts URLs, hostnames,
commands, unit names, interface names, or nft syntax. Every granted destination is
additionally bound to the link the kernel would actually use, which must be the
link its policy network was discovered on. Errors intentionally expose one short
code.
"""

import copy
import grp
import importlib.machinery
import importlib.util
import ipaddress
import json
import os
import secrets
import socket
import struct
import subprocess
import sys
import syslog
import tempfile
import time
from pathlib import Path

MAX_MESSAGE_BYTES = 16_384
UUID_RE = __import__("re").compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", __import__("re").I)
HEX64_RE = __import__("re").compile(r"^[0-9a-f]{64}$", __import__("re").I)
LEASE_RE = __import__("re").compile(r"^[0-9a-f]{32}$")
MAX_LEASE_MS = 300_000
MAX_UDP_PORTS = 64
POLICY_INSPECTOR_PATH = "/usr/lib/home-worker/live-stream-policy-inspector"
IP_BINARY = "/usr/sbin/ip"
IP_ENVIRONMENT = {"LANG": "C", "LC_ALL": "C", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}
# `serve()` is serial, so a hung `ip` stalls every queued grant behind it. A
# route get is a local netlink round trip; one second is already generous.
ROUTE_TIMEOUT_SECONDS = 1
MAX_ROUTE_BYTES = 64 * 1024
INSPECTOR_SYMBOLS = (
    "POLICY_VERSION", "EligibleNetwork", "valid_uid", "valid_interface", "valid_udp_port",
    "parse_network", "network_key", "policy_digest", "load_summary",
)


class Reject(Exception):
    """One short code, never a diagnostic.

    Two vocabularies for two audiences. `inspector`, `policy`, `summary`, and
    `state` are startup refusals an operator reads in the root journal; the rest
    -- `address`, `port`, `udp-range`, `route`, `interface`, `replay`, and the
    protocol codes -- answer one authenticated grant back over the socket.
    """

    def __init__(self, reason):
        super().__init__(reason)
        self.reason = reason


def strict_json_loads(raw):
    def unique_object(pairs):
        value = {}
        for key, item in pairs:
            if key in value:
                raise Reject("request")
            value[key] = item
        return value
    return json.loads(raw, object_pairs_hook=unique_object)


def journal(label, raw):
    """Raw route output belongs to the root journal only, never to the worker."""
    try:
        syslog.openlog("live-stream-net-helper", syslog.LOG_PID, syslog.LOG_DAEMON)
        syslog.syslog(syslog.LOG_ERR, "{}: {}".format(label, raw[:MAX_ROUTE_BYTES]))
    except Exception:
        return


def load_policy_inspector():
    """Load the root bundle inspector so canonical order and the digest exist once.

    Reimplementing either here is the drift that would silently disagree with the
    installer and permanently break readiness, so the helper reuses the same
    root-owned executable the installer and both verifiers already load.
    """
    try:
        loader = importlib.machinery.SourceFileLoader("live_stream_policy_inspector", POLICY_INSPECTOR_PATH)
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(module)
    except Exception:
        raise Reject("inspector")
    # A stale bundle -- the helper updated, the root asset not republished --
    # executes cleanly and only fails later, as an AttributeError raised deep in
    # policy parsing where no caller turns it into a code. The daemon starts at
    # boot without validate_root_bundle(), so the surface is checked here.
    if not all(hasattr(module, name) for name in INSPECTOR_SYMBOLS):
        raise Reject("inspector")
    return module


class Policy:
    """The installed policy version 2: private networks bound to physical links."""

    def __init__(self, raw, inspector):
        keys = {"version", "workerUid", "streamUid", "networks", "udpPortFirst", "udpPortLast", "digest"}
        if not isinstance(raw, dict) or set(raw) != keys or raw["version"] != inspector.POLICY_VERSION:
            raise Reject("policy")
        if not all(inspector.valid_uid(raw[key]) for key in ("workerUid", "streamUid")):
            raise Reject("policy")
        if not isinstance(raw["networks"], list) or not raw["networks"]:
            raise Reject("policy")
        entries = []
        self.networks = []
        for entry in raw["networks"]:
            if not isinstance(entry, dict) or set(entry) != {"family", "cidr", "interface"}:
                raise Reject("policy")
            network = inspector.parse_network(entry["cidr"])
            if network is None or entry["family"] != network.version or not inspector.valid_interface(entry["interface"]):
                raise Reject("policy")
            entries.append(inspector.EligibleNetwork(family=network.version, cidr=str(network), interface=entry["interface"]))
            self.networks.append((network, entry["interface"]))
        order = [inspector.network_key(entry) for entry in entries]
        if order != sorted(order) or len(set(order)) != len(order):
            raise Reject("policy")
        self.worker_uid = raw["workerUid"]
        self.stream_uid = raw["streamUid"]
        if self.worker_uid == self.stream_uid:
            raise Reject("policy")
        if not inspector.valid_udp_port(raw["udpPortFirst"]) or not inspector.valid_udp_port(raw["udpPortLast"]):
            raise Reject("policy")
        self.udp_first = raw["udpPortFirst"]
        self.udp_last = raw["udpPortLast"]
        if self.udp_first > self.udp_last or self.udp_last - self.udp_first + 1 > MAX_UDP_PORTS:
            raise Reject("policy")
        if not isinstance(raw["digest"], str) or not HEX64_RE.fullmatch(raw["digest"]):
            raise Reject("policy")
        self.digest = inspector.policy_digest(
            raw["version"], self.worker_uid, self.stream_uid, entries, self.udp_first, self.udp_last)
        if raw["digest"] != self.digest:
            raise Reject("policy")

    def address(self, text):
        if not isinstance(text, str):
            raise Reject("address")
        try:
            address = ipaddress.ip_address(text)
        except ValueError:
            raise Reject("address")
        if str(address) != text.lower() or address.is_global or address.is_multicast or address.is_unspecified:
            raise Reject("address")
        if not self._interfaces(address):
            raise Reject("address")
        return str(address)

    def interfaces(self, text):
        """Every policy link that already contains this validated address."""
        return self._interfaces(ipaddress.ip_address(text))

    def _interfaces(self, address):
        return frozenset(
            interface for network, interface in self.networks
            if address.version == network.version and address in network
        )


class StateStore:
    def __init__(self, path):
        self.path = Path(path)

    def load(self):
        try:
            raw = strict_json_loads(self.path.read_text(encoding="utf-8"))
        except FileNotFoundError:
            return {"version": 1, "leases": {}, "usedNonces": {}}
        except (OSError, ValueError):
            raise Reject("state")
        if not isinstance(raw, dict) or set(raw) != {"version", "leases", "usedNonces"} or raw["version"] != 1 or not isinstance(raw["leases"], dict) or not isinstance(raw["usedNonces"], dict):
            raise Reject("state")
        return raw

    def save(self, state):
        self.path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd, temporary = tempfile.mkstemp(prefix="state.", dir=self.path.parent)
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                json.dump(state, stream, separators=(",", ":"), sort_keys=True)
                stream.write("\n")
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, self.path)
        finally:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


class NftBackend:
    def apply(self, script):
        exists = subprocess.run(
            ["/usr/sbin/nft", "list", "table", "inet", "homeworker_stream"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=5, check=False,
        ).returncode == 0
        payload = (("delete table inet homeworker_stream\n" if exists else "") + script).encode()
        subprocess.run(
            ["/usr/sbin/nft", "-f", "-"], input=payload, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=5, check=True,
        )


class RouteBackend:
    """Asks the kernel which link one already-validated policy address leaves by.

    The address is re-rendered from `ipaddress`, passed as argv to the absolute
    allowlisted executable, and never reaches a shell. Answer semantics: the
    device name for an on-link destination, None when the kernel would route it
    somewhere the policy cannot describe, and Reject("route") when no answer
    could be established at all.
    """

    def interface(self, address):
        value = ipaddress.ip_address(address)
        argv = [IP_BINARY, "-4" if value.version == 4 else "-6", "-j", "route", "get", str(value)]
        try:
            completed = subprocess.run(
                argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                env=IP_ENVIRONMENT, timeout=ROUTE_TIMEOUT_SECONDS, check=False,
            )
        except (OSError, subprocess.SubprocessError) as error:
            # The worker only ever sees "route"; these breadcrumbs are what tells
            # an operator whether `ip` is missing, hung, or answering an error.
            journal("route", "ip failed: " + type(error).__name__)
            raise Reject("route")
        if completed.returncode != 0:
            journal("route", "ip exited {}".format(completed.returncode))
            raise Reject("route")
        if len(completed.stdout) > MAX_ROUTE_BYTES:
            journal("route", "ip returned {} bytes".format(len(completed.stdout)))
            raise Reject("route")
        try:
            raw = completed.stdout.decode("utf-8")
        except UnicodeDecodeError:
            journal("route", "ip returned undecodable output")
            raise Reject("route")
        try:
            parsed = strict_json_loads(raw)
        except (Reject, ValueError):
            journal("route", raw)
            raise Reject("route")
        if not isinstance(parsed, list) or len(parsed) != 1 or not isinstance(parsed[0], dict):
            journal("route", raw)
            raise Reject("route")
        record = parsed[0]
        device = record.get("dev")
        if not isinstance(device, str):
            journal("route", raw)
            raise Reject("route")
        # A gateway, a multipath answer, or a non-unicast type all mean the
        # destination is not on-link, so no policy network can vouch for it.
        if record.get("gateway") is not None or record.get("via") is not None or record.get("nexthops") is not None:
            return None
        if record.get("type") not in (None, "unicast"):
            return None
        return device


class Engine:
    def __init__(self, policy, store, nft, routes, now_ms=None, lease_id=None):
        self.policy = policy
        self.store = store
        self.nft = nft
        self.routes = routes
        self.now_ms = now_ms or (lambda: int(time.time() * 1000))
        self.lease_id = lease_id or (lambda: secrets.token_hex(16))
        self.state = store.load()
        self.recover()

    def recover(self):
        now = self.now_ms()
        leases = {}
        for key, value in self.state["leases"].items():
            try:
                if not isinstance(key, str) or not LEASE_RE.fullmatch(key):
                    raise Reject("state")
                leases[key] = self._validate_persisted_lease(value, now)
            except Reject:
                continue
        nonces = {}
        for key, value in self.state["usedNonces"].items():
            if not isinstance(key, str) or not HEX64_RE.fullmatch(key) or not isinstance(value, int) or isinstance(value, bool):
                raise Reject("state")
            if value <= now:
                continue
            if value > now + MAX_LEASE_MS or key.lower() in nonces:
                raise Reject("state")
            nonces[key.lower()] = value
        self.state["leases"] = leases
        self.state["usedNonces"] = nonces
        self._commit(self.state)

    def _validate_persisted_lease(self, value, now):
        keys = {"sessionId", "addresses", "rtspControlPorts", "transport", "udpMediaPorts", "expiresAtUnixMs"}
        if not isinstance(value, dict) or set(value) != keys:
            raise Reject("state")
        session = valid_session(value["sessionId"])
        expiry = value["expiresAtUnixMs"]
        if not isinstance(expiry, int) or isinstance(expiry, bool) or not now < expiry <= now + MAX_LEASE_MS:
            raise Reject("state")
        addresses = value["addresses"]
        if not isinstance(addresses, list) or not 1 <= len(addresses) <= 2:
            raise Reject("state")
        # A restored lease is re-checked against the current policy rather than
        # against a fresh route lookup: the binding was proven when the lease was
        # granted, every lease expires within MAX_LEASE_MS, and startup must not
        # depend on a live query whose transient failure would drop live rules.
        addresses = [self._restore_address(entry) for entry in addresses]
        if len({entry["address"] for entry in addresses}) != len(addresses):
            raise Reject("state")
        ports = value["rtspControlPorts"]
        if not isinstance(ports, list) or not 1 <= len(ports) <= 2:
            raise Reject("state")
        ports = [valid_port(port, "state") for port in ports]
        if len(ports) != len(set(ports)):
            raise Reject("state")
        transport = value["transport"]
        udp = value["udpMediaPorts"]
        if transport == "tcp":
            if udp is not None:
                raise Reject("state")
        elif transport in ("udp", "auto"):
            if not isinstance(udp, dict) or set(udp) != {"first", "last"}:
                raise Reject("state")
            first = valid_port(udp["first"], "state")
            last = valid_port(udp["last"], "state")
            if first != self.policy.udp_first or last != self.policy.udp_last:
                raise Reject("state")
            udp = {"first": first, "last": last}
        else:
            raise Reject("state")
        return {"sessionId": session, "addresses": addresses, "rtspControlPorts": ports, "transport": transport, "udpMediaPorts": udp, "expiresAtUnixMs": expiry}

    def _restore_address(self, entry):
        if not isinstance(entry, dict) or set(entry) != {"address", "interface"}:
            raise Reject("state")
        address = self.policy.address(entry["address"])
        if entry["interface"] not in self.policy.interfaces(address):
            raise Reject("state")
        return {"address": address, "interface": entry["interface"]}

    def _bind(self, address):
        """The kernel must agree that this address leaves through its policy link."""
        device = self.routes.interface(address)
        if device is None or device not in self.policy.interfaces(address):
            raise Reject("interface")
        return {"address": address, "interface": device}

    def handle(self, request):
        self._prune()
        if not isinstance(request, dict) or not isinstance(request.get("op"), str):
            raise Reject("request")
        if request["op"] == "grant":
            return self._grant(request)
        if request["op"] == "revoke":
            return self._revoke(request)
        raise Reject("operation")

    def _prune(self):
        now = self.now_ms()
        next_state = copy.deepcopy(self.state)
        next_state["leases"] = {key: value for key, value in next_state["leases"].items() if isinstance(value, dict) and value.get("expiresAtUnixMs", 0) > now}
        next_state["usedNonces"] = {key: value for key, value in next_state["usedNonces"].items() if isinstance(value, int) and value > now}
        if next_state != self.state:
            self._commit(next_state)

    def _grant(self, request):
        tcp_keys = {"op", "sessionId", "nonceHash", "addresses", "rtspControlPorts", "transport", "expiresAtUnixMs"}
        udp_keys = tcp_keys | {"udpMediaPorts"}
        if set(request) not in (tcp_keys, udp_keys):
            raise Reject("unknown-field")
        session = valid_session(request.get("sessionId"))
        nonce = request.get("nonceHash")
        if not isinstance(nonce, str) or not HEX64_RE.fullmatch(nonce):
            raise Reject("nonce")
        nonce = nonce.lower()
        now = self.now_ms()
        expiry = request.get("expiresAtUnixMs")
        if not isinstance(expiry, int) or isinstance(expiry, bool) or expiry <= now or expiry - now > MAX_LEASE_MS:
            raise Reject("expiry")
        addresses = request.get("addresses")
        if not isinstance(addresses, list) or not 1 <= len(addresses) <= 2:
            raise Reject("address")
        addresses = [self.policy.address(value) for value in addresses]
        if len(set(addresses)) != len(addresses):
            raise Reject("address")
        ports = request.get("rtspControlPorts")
        if not isinstance(ports, list) or not 1 <= len(ports) <= 2:
            raise Reject("port")
        ports = [valid_port(value) for value in ports]
        if len(set(ports)) != len(ports):
            raise Reject("port")
        transport = request.get("transport")
        udp = None
        if transport == "tcp":
            if set(request) != tcp_keys:
                raise Reject("unknown-field")
        elif transport in ("udp", "auto"):
            if set(request) != udp_keys or not isinstance(request.get("udpMediaPorts"), dict) or set(request["udpMediaPorts"]) != {"first", "last"}:
                raise Reject("udp-range")
            first = valid_port(request["udpMediaPorts"].get("first"), "udp-range")
            last = valid_port(request["udpMediaPorts"].get("last"), "udp-range")
            if first != self.policy.udp_first or last != self.policy.udp_last or last - first + 1 > MAX_UDP_PORTS:
                raise Reject("udp-range")
            udp = {"first": first, "last": last}
        else:
            raise Reject("transport")
        if nonce in self.state["usedNonces"]:
            raise Reject("replay")
        # Last, so a malformed or replayed request never reaches the kernel.
        addresses = [self._bind(value) for value in addresses]
        lease = self.lease_id()
        if not LEASE_RE.fullmatch(lease) or lease in self.state["leases"]:
            raise Reject("lease")
        next_state = copy.deepcopy(self.state)
        next_state["usedNonces"][nonce] = expiry
        next_state["leases"][lease] = {
            "sessionId": session, "addresses": addresses, "rtspControlPorts": ports,
            "transport": transport, "udpMediaPorts": udp, "expiresAtUnixMs": expiry,
        }
        self._commit(next_state)
        return {"ok": True, "leaseId": lease}

    def _revoke(self, request):
        if set(request) != {"op", "sessionId", "leaseId"}:
            raise Reject("unknown-field")
        session = valid_session(request.get("sessionId"))
        lease = request.get("leaseId")
        if not isinstance(lease, str) or not LEASE_RE.fullmatch(lease):
            raise Reject("lease")
        current = self.state["leases"].get(lease)
        if current is None or current.get("sessionId") != session:
            raise Reject("lease")
        next_state = copy.deepcopy(self.state)
        del next_state["leases"][lease]
        self._commit(next_state)
        return {"ok": True}

    def _commit(self, next_state):
        old_state = self.state
        try:
            self.nft.apply(render_nft(self.policy.stream_uid, next_state["leases"], self.now_ms()))
            self.store.save(next_state)
            self.state = next_state
        except Exception:
            try:
                self.nft.apply(render_nft(self.policy.stream_uid, old_state["leases"], self.now_ms()))
            except Exception:
                pass
            raise Reject("backend")


def render_nft(stream_uid, leases, now_ms):
    lines = ["table inet homeworker_stream {"]
    rules = []
    for lease_id, lease in sorted(leases.items()):
        if not isinstance(lease, dict) or lease.get("expiresAtUnixMs", 0) <= now_ms:
            continue
        remaining = (lease["expiresAtUnixMs"] - now_ms) // 1000
        if remaining < 1:
            continue
        suffix = lease_id
        # Set names index the lease's sorted distinct devices rather than naming
        # them: an interface name may legally hold `.` or `-`, which are not safe
        # in an nft identifier, so no kernel-chosen name ever reaches the script.
        devices = sorted({entry["interface"] for entry in lease["addresses"]})
        for index, device in enumerate(devices):
            bound = [entry["address"] for entry in lease["addresses"] if entry["interface"] == device]
            for version, nft_type, prefix in ((4, "ipv4_addr", "ip"), (6, "ipv6_addr", "ip6")):
                addresses = [value for value in bound if ipaddress.ip_address(value).version == version]
                if not addresses:
                    continue
                tcp_name = "l_{}_{}_{}_tcp".format(suffix, index, version)
                elements = ["{} . {} timeout {}s".format(address, port, remaining) for address in addresses for port in lease["rtspControlPorts"]]
                lines.append(" set {} {{ type {} . inet_service; flags timeout; elements = {{ {} }}; }}".format(tcp_name, nft_type, ", ".join(elements)))
                rules.append('  meta skuid {} oifname "{}" {} daddr . tcp dport @{} accept'.format(stream_uid, device, prefix, tcp_name))
                if lease["transport"] in ("udp", "auto"):
                    udp_name = "l_{}_{}_{}_udp".format(suffix, index, version)
                    udp_elements = ["{} timeout {}s".format(address, remaining) for address in addresses]
                    lines.append(" set {} {{ type {}; flags timeout; elements = {{ {} }}; }}".format(udp_name, nft_type, ", ".join(udp_elements)))
                    udp = lease["udpMediaPorts"]
                    rules.append('  meta skuid {} oifname "{}" {} daddr @{} udp sport {}-{} accept'.format(stream_uid, device, prefix, udp_name, udp["first"], udp["last"]))
    lines.extend([
        " chain output {",
        "  type filter hook output priority filter; policy accept;",
        *rules,
        "  meta skuid {} reject".format(stream_uid),
        " }",
        "}",
    ])
    return "\n".join(lines) + "\n"


def valid_port(value, reason="port"):
    if not isinstance(value, int) or isinstance(value, bool) or not 1 <= value <= 65535:
        raise Reject(reason)
    return value


def valid_session(value):
    if not isinstance(value, str) or not UUID_RE.fullmatch(value):
        raise Reject("session")
    return value.lower()


def load_verified_policy(path, inspector):
    """Load the private policy and require the public summary to describe it.

    The two artifacts are renamed one after the other, so a crash can leave a new
    private policy beside an old public summary. When the change implied no route
    change -- a recreated stream account, an edited UDP range -- nothing else in
    the system notices, because application readiness only ever compares the
    environment with the summary. This is that cross-check. `load_summary`
    re-derives the summary digest from the summary's own fields, so digest
    equality proves every security-relevant field of the two agrees.
    """
    try:
        raw = strict_json_loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError, Reject):
        raise Reject("policy")
    policy = Policy(raw, inspector)
    try:
        digest, _networks = inspector.load_summary()
    except Exception:
        raise Reject("summary")
    if digest != policy.digest:
        raise Reject("summary")
    return policy


def serve(policy_path, state_path, socket_path, group_name):
    inspector = load_policy_inspector()
    policy = load_verified_policy(policy_path, inspector)
    engine = Engine(policy, StateStore(state_path), NftBackend(), RouteBackend())
    group_id = grp.getgrnam(group_name).gr_gid
    path = Path(socket_path)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o750)
    try:
        path.unlink()
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    os.chown(path, 0, group_id)
    os.chmod(path, 0o660)
    server.listen(8)
    while True:
        connection, _ = server.accept()
        with connection:
            response = {"ok": False, "reason": "request"}
            try:
                if not hasattr(socket, "SO_PEERCRED"):
                    raise Reject("peer")
                _pid, uid, _gid = struct.unpack("3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
                if uid != policy.worker_uid:
                    raise Reject("peer")
                data = read_capped_request(connection, time.monotonic() + 2.0)
                if len(data) > MAX_MESSAGE_BYTES or not data.endswith(b"\n") or b"\n" in data[:-1]:
                    raise Reject("request")
                request = strict_json_loads(data.decode("utf-8"))
                response = engine.handle(request)
            except Reject as error:
                response = {"ok": False, "reason": error.reason}
            except Exception:
                response = {"ok": False, "reason": "request"}
            send_response(connection, response)


def read_capped_request(connection, deadline):
    data = bytearray()
    while len(data) <= MAX_MESSAGE_BYTES:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise Reject("request")
        connection.settimeout(remaining)
        chunk = connection.recv(min(4096, MAX_MESSAGE_BYTES + 1 - len(data)))
        if not chunk:
            break
        data.extend(chunk)
        if b"\n" in chunk:
            break
    return data


def send_response(connection, response):
    try:
        connection.settimeout(2.0)
        connection.sendall((json.dumps(response, separators=(",", ":")) + "\n").encode())
        return True
    except OSError:
        return False


def main():
    if os.geteuid() != 0:
        print("live-stream-net-helper must run as root", file=sys.stderr)
        return 1
    try:
        serve(
            os.environ.get("HOMEWORKER_STREAM_POLICY", "/etc/home-worker/live-stream-policy.json"),
            os.environ.get("HOMEWORKER_STREAM_STATE", "/run/home-worker-stream-net/state.json"),
            os.environ.get("HOMEWORKER_STREAM_SOCKET", "/run/home-worker-stream-net/helper.sock"),
            os.environ.get("HOMEWORKER_STREAM_GROUP", "homeworker-stream"),
        )
    except Reject as error:
        # One short code, never a traceback that would quote the policy itself.
        print("live-stream-net-helper refused to start: " + error.reason, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
